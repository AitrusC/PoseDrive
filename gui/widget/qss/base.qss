QWidget {
    background-color: transparent;
    font: bold 10pt "Microsoft YaHei";
    color: rgb(196, 203, 207);
}
SearchLine {
    background-color: rgb(58, 65, 63);
    border-radius: 0px;
    border: 0px solid transparent;
}
_JPlistWidget {
    border-radius: 0px;
    border: 0px solid transparent;
    padding: 0px;
}
_ShapeListWidget {
    border-radius: 0px;
    border: 0px solid transparent;
    padding: 0px;
}
_ToolButton {
    background-color: rgb(87, 106, 95);
    border-radius: 5px;
}
_ToolButton:hover {
    background-color: rgb(54, 92, 80);
}
_ToolButton:pressed {
    background-color: rgb(67, 105, 93);
}
_ToolButton:checked {
    background-color: rgb(18, 110, 130);
}
_ToolButton:checked:hover {
    background-color: rgb(54, 92, 80);
}
_ToolButton:checked:pressed {
    background-color: rgb(67, 105, 93);
}
_MenuWidget {
    background-color: rgb(37, 44, 42);
    border-radius: 0px;
    border: 0px solid transparent;
    padding: 0px;
}
_MenuWidget::item::selected {
    background-color: rgb(55, 62, 59);
}


/* 垂直滚动条：轨道 */
QScrollBar:vertical {
    background: rgb(45, 53, 49);
    width: 10px;
    margin: 0px;
    border: none;
    border-radius: 4px;
}

/* 可拖动的滑块 */
QScrollBar::handle:vertical {
    background: rgb(87, 106, 95);
    min-height: 24px;
    border-radius: 4px;
}

/* 隐藏上下两端的按钮 */
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
    border: none;
    background: transparent;
}

QScrollBar::up-arrow:vertical,
QScrollBar::down-arrow:vertical {
    image: none;
}

/* 滑块上方、下方的轨道区域 */
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: transparent;
}
